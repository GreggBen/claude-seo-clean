#!/usr/bin/env bash
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if (( $# < 1 )); then
  echo "Usage: run-script <script-name.py> [arguments...]" >&2
  exit 2
fi

script_name="$1"
shift

if [[ ! "${script_name}" =~ ^[A-Za-z0-9_-]+\.py$ ]]; then
  echo "Invalid script name: ${script_name}" >&2
  exit 2
fi

script_path="${SKILL_DIR}/scripts/${script_name}"
if [[ ! -f "${script_path}" ]]; then
  echo "Unknown SEO script: ${script_name}" >&2
  exit 2
fi

python_bin="${SKILL_DIR}/.venv/bin/python"
if [[ ! -x "${python_bin}" ]]; then
  python_bin="$(command -v python3 || true)"
fi
if [[ -z "${python_bin}" ]]; then
  echo "Python 3 is required to run SEO scripts." >&2
  exit 1
fi

exec "${python_bin}" "${script_path}" "$@"
